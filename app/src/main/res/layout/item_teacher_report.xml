<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="12dp"
    android:layout_marginTop="7dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="7dp"

    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#E7E9F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- SUBJECT -->

        <TextView
            android:id="@+id/tvReportSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Java"
            android:textColor="#171923"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- CLASS -->

        <TextView
            android:id="@+id/tvReportClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2nd IT"
            android:textColor="#4B5563"
            android:textSize="14sp" />

        <!-- ROOM -->

        <TextView
            android:id="@+id/tvReportRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Room: 101"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <!-- DATE -->

        <TextView
            android:id="@+id/tvReportDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="16 Sep 2026, 10:30 AM"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#ECEEF3" />

        <!-- STATS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReportPresent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Present: 28"
                android:textColor="#16803C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportAbsent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Absent: 12"
                android:textColor="#C62828"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Total: 40"
                android:textColor="#4B5563"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- PERCENTAGE -->

        <TextView
            android:id="@+id/tvReportPercentage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="70.0%"
            android:textColor="#171923"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>