<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- ================================================== -->
        <!-- HEADER -->
        <!-- ================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Lecture"
            android:textColor="#111827"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Create a new attendance session and select the classes that should receive this lecture."
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />


        <!-- ================================================== -->
        <!-- LECTURE DETAILS TITLE -->
        <!-- ================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Lecture Details"
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold" />


        <!-- ================================================== -->
        <!-- SUBJECT -->
        <!-- ================================================== -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Subject"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSubject"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#111827"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ================================================== -->
        <!-- TARGET CLASSES SECTION -->
        <!-- ================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Target Classes"
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Select one or more years that should be able to attend this lecture."
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />


        <!-- ================================================== -->
        <!-- CLASS SELECTION CARD -->
        <!-- ================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">


                <!-- ================================================== -->
                <!-- 1ST YEAR -->
                <!-- ================================================== -->

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/CbClass1"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="1st IT"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    app:buttonTint="@color/student_nav_color" />


                <!-- ================================================== -->
                <!-- DIVIDER -->
                <!-- ================================================== -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="#F0F1F4" />


                <!-- ================================================== -->
                <!-- 2ND YEAR -->
                <!-- ================================================== -->

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/CbClass2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="2nd IT"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    app:buttonTint="@color/student_nav_color" />


                <!-- ================================================== -->
                <!-- DIVIDER -->
                <!-- ================================================== -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="#F0F1F4" />


                <!-- ================================================== -->
                <!-- 3RD YEAR -->
                <!-- ================================================== -->

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/CbClass3"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="3rd IT"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    app:buttonTint="@color/student_nav_color" />


                <!-- ================================================== -->
                <!-- DIVIDER -->
                <!-- ================================================== -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="#F0F1F4" />


                <!-- ================================================== -->
                <!-- 4TH YEAR -->
                <!-- ================================================== -->

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/CbClass4"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="4th IT"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    app:buttonTint="@color/student_nav_color" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================== -->
        <!-- TARGET CLASS INFO -->
        <!-- ================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#EFF6FF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#DBEAFE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">


                <!-- INFO ICON -->
                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="#DBEAFE"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="#2563EB"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- INFO TEXT -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:text="All divisions of the selected year will be eligible. For example, selecting 2nd IT includes 2nd IT A, B, C and D."
                    android:textColor="#1E40AF"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================== -->
        <!-- ROOM SECTION -->
        <!-- ================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Room"
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold" />


        <!-- ================================================== -->
        <!-- ROOM NUMBER -->
        <!-- ================================================== -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Room Number"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoomNo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#111827"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ================================================== -->
        <!-- TIMING SECTION -->
        <!-- ================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Lecture Timing"
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Optional timing information for the teacher. It does not control lecture visibility or attendance."
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />


        <!-- ================================================== -->
        <!-- TIME ROW -->
        <!-- ================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">


            <!-- ================================================== -->
            <!-- START TIME -->
            <!-- ================================================== -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Start Time"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_recent_history"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStartTime"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:inputType="none"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="#111827"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================================================== -->
            <!-- SPACE -->
            <!-- ================================================== -->

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />


            <!-- ================================================== -->
            <!-- END TIME -->
            <!-- ================================================== -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="End Time"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_recent_history"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEndTime"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:inputType="none"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="#111827"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>


        <!-- ================================================== -->
        <!-- TIME INFORMATION -->
        <!-- ================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#F9FAFB"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="13dp">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="#E5E7EB"
                    android:gravity="center"
                    android:text="⏱"
                    android:textColor="#4B5563"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:text="These times are only for your reference. Students will see the lecture while its status is ACTIVE."
                    android:textColor="#6B7280"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================== -->
        <!-- START LECTURE BUTTON -->
        <!-- ================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartLecture"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="START LECTURE"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="15dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />


        <!-- ================================================== -->
        <!-- BOTTOM SPACE -->
        <!-- ================================================== -->

        <Space
            android:layout_width="match_parent"
            android:layout_height="4dp" />

    </LinearLayout>

</ScrollView>