<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"

    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Initial -->

        <TextView
            android:id="@+id/tvStudentInitial"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="O"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/bg_circle"/>

        <!-- Student Info -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvLiveStudentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Om Shende"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/tvLiveStudentRoll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="A-01"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvLiveStudentEnrollment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Enrollment: 123456"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvLiveAttendanceTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Marked at 10:30:22 AM"
                android:textSize="11sp"/>

        </LinearLayout>

        <!-- Present -->

        <TextView
            android:id="@+id/tvLiveAttendanceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRESENT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_present_badge"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>